{
	"name": "spatial-photos",
	"version": "0.1.3",
	"description": "A web component for viewing .spatial photos.",
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md",
		"THIRD_PARTY_LICENSES.txt"
	],
	"sideEffects": [
		"./dist/index.js"
	],
	"scripts": {
		"build": "node build.js",
		"dev": "vite --host 127.0.0.1",
		"predev": "npm run build",
		"prepack": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frozein/SpatialPhotos.git",
		"directory": "viewer"
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"three": "0.160.0",
		"vite": "^7.0.0"
	},
	"keywords": [
		"spatial-photo",
		"web-component",
		"react",
		"three",
		"spatial",
		"3d"
	]
}
