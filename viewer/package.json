{
	"name": "spatial-photos",
	"version": "0.1.0",
	"description": "A web component for viewing JPEG spatial photo meshes.",
	"type": "module",
	"license": "UNLICENSED",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md", "THIRD_PARTY_LICENSES.txt"],
	"sideEffects": ["./dist/index.js"],
	"scripts": {
		"build": "node build.js",
		"test": "npm run build && node --test test/*.test.js && tsc --noEmit",
		"dev": "vite --host 127.0.0.1",
		"predev": "npm run build",
		"prepack": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frozein/SpatialPhotos.git",
		"directory": "viewer"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"esbuild": "^0.25.0",
		"happy-dom": "^20.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"three": "0.160.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0"
	},
	"keywords": ["spatial-photo", "web-component", "react", "three", "spatial", "3d"]
}
